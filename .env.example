# ─────────────────────────────────────────────────────
#  SIH DR Screening Backend – Environment Variables
#  Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────

# Express server port
PORT=5000

# MongoDB connection string
# Local:   mongodb://localhost:27017/sih_dr_screening
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/sih_dr_screening
MONGO_URI=your_mongodb_connection_string

# JWT secret — use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_secret

# JWT token expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# URL of the existing FastAPI ML service
ML_SERVICE_URL=http://localhost:8000

# React frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=development
